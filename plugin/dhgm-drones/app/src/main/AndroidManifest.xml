<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ge.dronehub.dhgm.plugin"
    tools:ignore="GoogleAppIndexingWarning">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_drone_tool"
        android:label="@string/dhgm_drones_title"
        android:description="@string/dhgm_drones_summary"
        android:extractNativeLibs="true"
        android:theme="@style/ATAKPluginTheme">

        <meta-data android:name="plugin-api" android:value="${atakApiVersion}"/>
        <meta-data android:name="app_desc" android:value="@string/dhgm_drones_summary"/>

        <!-- ATAK 4.6.0.2+ plugin discovery -->
        <activity android:name="com.atakmap.app.component" tools:ignore="MissingClass">
            <intent-filter android:label="@string/dhgm_drones_title">
                <action android:name="com.atakmap.app.component" />
            </intent-filter>
        </activity>
    </application>
</manifest>
