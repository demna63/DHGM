    <color name="dhgm_bg_base">#0B0E14</color>      <!-- bgBase -->
    <color name="dhgm_bg_surface">#151A23</color>   <!-- bgSurface (პანელი) -->
    <color name="dhgm_bg_elevated">#1E2530</color>  <!-- bgElevated (ბარათი) -->
    <color name="dhgm_divider">#2A323F</color>      <!-- divider -->

    <!-- აქცენტები -->
