<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151A23"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/dhgm_panel_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dhgm_drones_title"
        android:textColor="#64D2FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dhgm_bridge_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dhgm_bridge_disconnected"
        android:textColor="#9AA6B8"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/dhgm_drone_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
