    <string name="preferences_text51">გამოდის დიალოგი გასვლის დასადასტურებლად, სწრაფი დახურვის ნაცვლად.</string>
    <string name="preferences_text61">ჩართვისას კლავიატურის დაბლოკვა სისტემაში გამორთული იქნება!</string>
    <string name="preferences_text63">გაშვებისას იძულებით ჩართეთ თვითმფრინავის რეჟიმი. ეს მხარდაჭერილია მხოლოდ ზოგიერთ ძველ ტელეფონზე და, სავარაუდოდ, KitKat ან უახლეს სისტემებზე არ იმუშავებს. თუ გაშვებისას რადიო ან Wi-Fi არ გამორთდება, მოწყობილობა ამ ფუნქციას არ უჭერს მხარს.</string>
    <string name="preferences_text64">ტექსტურის ერთეულების მაქსიმალური რაოდენობის გამოყენება</string>
    <string name="preferences_text65">მოხსენით, თუ მარკერებისა და ეტიკეტების ჩვენებასთან დაკავშირებული პრობლემებია.</string>
    <string name="preferences_text66">ტექსტურის ასლების ჩართვა</string>
    <string name="preferences_text69">ჩართვისას, სისტემური ჟურნალი (logcat) ფაილში ჩაიწერება აპლიკაციის მუშაობისას. ფაილი იქმნება აპლიკაციის მხარდაჭერის დირექტორიაში logcat.txt სახელით და ყოველი გაშვებისას გადაიწერება.</string>
    <string name="preferences_text70">მხოლოდ Logcat შეცდომების ჩართვა</string>
    <string name="preferences_text71">ჩართვისას, ჟურნალი მხოლოდ შეცდომის დონის დიაგნოსტიკურ ინფორმაციას ჩაიწერს.</string>
    <string name="preferences_text701">Debug ჟურნალების ატვირთვა</string>
    <string name="preferences_text701s">ჩართვისას, debug ჟურნალები (Logcat და ქსელის ტრაფიკი) TAK სერვერზე ატვირთული იქნება.</string>
    <string name="preferences_text73">დააყენეთ ხელსაწყოთა პანელის ხატულების ფერი. შენიშვნა: ზოგიერთი plugin-ის ხატულა შეიძლება გამოყენებულ ფერს ვერ შეხამდეს.</string>
    <string name="preferences_text74">ხელსაწყოთა პანელის ფონის ფერი</string>
    <string name="preferences_text75">დააყენეთ ხელსაწყოთა პანელის ფონის ფერი. შენიშვნა: ფონის ფერი გამჭვირვალე იქნება.</string>
    <string name="preferences_text76">ხელსაწყოთა პანელის ფერების ნაგულისხმევად გადაყენება</string>
    <string name="preferences_text77">ხელსაწყოთა პანელის ხატულებისა და ფონის ფერს ნაგულისხმევ პარამეტრებზე დააბრუნებს.</string>
    <string name="preferences_text404">ხელსაწყოთა პანელის ფერის პარამეტრები</string>
    <string name="preferences_text405">დარწმუნებული ხართ, რომ გსურთ ხელსაწყოთა პანელის ყველა ფერის ნაგულისხმევად გადაყენება?</string>
    <string name="preferences_text406">შერჩეული ფერი შეიძლება ნაკლებად ჩანდეს მუქ რუკებზე. მაინც გსურთ გაგრძელება?</string>
    <string name="preferences_text407">ამ ფერის გამოყენება</string>
    <string name="preferences_text408">ფერის შესარჩევად გამოიყენეთ RGB სლაიდერები.</string>
    <string name="preferences_text78">აირჩიეთ თქვენი გუნდი.</string>
    <string name="preferences_text79">ჩემი გუნდი</string>
    <string name="preferences_text80">განსაზღვრავს ამ მოწყობილობის როლს</string>
    <string name="preferences_text81">ჩემი როლი</string>
    <string name="preferences_text83">განსაზღვრავს ტიპს, რომლითაც სხვები ხედავენ ამ მოწყობილობას</string>
    <string name="preferences_text84">ჩვენების ტიპი</string>
    <string name="preferences_text85">GPS დროის გამოყენება</string>
    <string name="preferences_text86">ჩართვისას, მოწყობილობა GPS დროს გამოიყენებს, თუ ხელმისაწვდომია.</string>
    <string name="preferences_text87">კონტაქტის პარამეტრები</string>
    <string name="preferences_text88">ტელეფონის ნომრის გამოქვეყნება</string>
    <string name="preferences_text89">ტელეფონის ნომრის (თუ ხელმისაწვდომია) სხვა მომხმარებლებისთვის ჩვენება და პირდაპირი სატელეფონო ზარებისა და SMS შეტყობინებების (თუ ორივე მოწყობილობა უჭერს მხარს) დაშვება</string>
    <string name="preferences_text90">განსაზღვრავს, გამოქვეყნდეს თუ არა VoIP მისამართი და კონფიგურაცია ავტომატურად ან ხელით.</string>
    <string name="preferences_text91">VoIP ნომრის გამოქვეყნება</string>
